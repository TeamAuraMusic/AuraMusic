<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature
        android:name="android.software.leanback"
        android:required="true" />

    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application
        android:banner="@mipmap/tv_banner"
        android:label="@string/app_name_tv"
        tools:replace="android:banner,android:label">

        <provider
            android:name=".tv.TvPreviewContentProvider"
            android:authorities="${applicationId}.tvpreview"
            android:exported="true"
            android:grantUriPermissions="true" />

        <service
            android:name=".tv.TvPreviewFocusAccessibilityService"
            android:exported="true"
            android:label="@string/tv_preview_indicator_service"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/tv_preview_indicator_accessibility_service" />
        </service>

        <activity
            android:name=".TvMainActivity"
            android:exported="true"
            android:banner="@mipmap/tv_banner"
            android:icon="@mipmap/ic_launcher"
            android:launchMode="singleTask"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation"
            android:theme="@style/Theme.AuraMusic">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Refresh recommendations on device boot -->
        <receiver
            android:name=".tv.TvBootReceiver"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Hide the phone launcher aliases on TV. -->
        <activity-alias
            android:name=".MainActivityAlias"
            tools:node="remove" />

        <activity-alias
            android:name=".MainActivityStatic"
            tools:node="remove" />
    </application>
</manifest>
